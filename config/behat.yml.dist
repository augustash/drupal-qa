# drupal-qa default Behat config, used when a project has no behat.yml of its
# own. CI supplies the environment's URL and Drush alias through BEHAT_PARAMS.
#
# Scenarios run over HTTP against the deployed environment. Scenarios tagged
# @api also create users and content there, through Drush over SSH.
default:
  autoload:
    - '%paths.base%/tests/behat/bootstrap'
  suites:
    default:
      paths:
        - '%paths.base%/vendor/augustash/drupal-qa/tests/behat/features/drupal'
        - '%paths.base%/tests/behat/features'
      contexts:
        - DrupalQa\Behat\FeatureContext
        - Drupal\DrupalExtension\Context\DrupalContext
        - Drupal\DrupalExtension\Context\MinkContext
        - Drupal\DrupalExtension\Context\MessageContext
    commerce:
      paths:
        - '%paths.base%/vendor/augustash/drupal-qa/tests/behat/features/commerce'
      contexts:
        - DrupalQa\Behat\FeatureContext
        - Drupal\DrupalExtension\Context\DrupalContext
        - Drupal\DrupalExtension\Context\MinkContext
        - Drupal\DrupalExtension\Context\MessageContext
  extensions:
    Drupal\MinkExtension:
      browserkit_http: ~
      base_url: 'http://localhost'
    Drupal\DrupalExtension:
      blackbox: ~
      api_driver: drush
      drush:
        alias: '@self'
      selectors:
        message_selector: '.messages'
        error_message_selector: '.messages--error'
        success_message_selector: '.messages--status'
        warning_message_selector: '.messages--warning'
