# drupal-qa default PHPStan config, used when a project has none of its own.
# CI passes the paths to analyse (custom modules, profiles and every theme
# that is not contrib) on the command line, so none are listed here: paths in
# this file would resolve relative to vendor/, not to the project.
parameters:
  level: 1
  fileExtensions:
    - php
    - module
    - inc
    - install
    - theme
  ignoreErrors:
    - '#^Unsafe usage of new static#'
    - '#Drupal calls should be avoided in classes, use dependency injection instead#'
    - '#^Plugin definitions cannot be altered.#'
    - '#^Class .* extends @internal class#'
